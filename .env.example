# =============================================================================
# StockX — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (plain postgres:17-alpine — no TimescaleDB required)
# ---------------------------------------------------------------------------
POSTGRES_USER=stockx
POSTGRES_PASSWORD=stockx_secret
POSTGRES_DB=stockx

# Full connection string used by Prisma and the Execution Service worker
DATABASE_URL="postgresql://stockx:stockx_secret@postgres:5432/stockx"

# ---------------------------------------------------------------------------
# Redis (message bus — API Gateway ↔ Matcher, pub/sub for Realtime)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Next.js / NextAuth
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_random_32_char_secret

# ---------------------------------------------------------------------------
# Public URLs (browser-side env vars — must be set at build time for Docker)
# ---------------------------------------------------------------------------

# REST API base URL (used by Next.js frontend to call the API Gateway)
NEXT_PUBLIC_REST_API_URL=http://localhost:3001/api/v1

# WebSocket URL (used by MarketDataManager to connect to the Realtime Service)
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:3002

# Full base URL of the web app (used for absolute links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
